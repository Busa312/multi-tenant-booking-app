{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["SITE_URL", "BLOCK_SEARCH_ENGINES", "PUBLIC_CMS_URL", "API_URL", "VERCEL"],
