---
import { getImage } from "astro:assets";
import { BLOCK_SEARCH_ENGINES } from "astro:env/server";
import { defaultLocale, locales, localeHome, messagesFor, type Locale, type Messages } from "../i18n";
import { loadPlans } from "../lib/plans";
import { shareImageFor } from "../lib/shareImages";
import { brandName } from "../lib/site";
import { structuredData, toJsonLd } from "../lib/structuredData";
import "../styles/global.css";

interface Props {
  locale: Locale;
  t: Messages;
  /** The page under each language's home, e.g. "contact/"; empty = the home page. */
  path?: string;
  /** The page's own title and description; the home page's when left out. */
  title?: string;
  description?: string;
  /** A page that has no business in search results (the contact form's outcomes). */
  noindex?: boolean;
}

const { locale, t, path = "", noindex = false } = Astro.props;
const absolute = (href: string) => new URL(href, Astro.site).href;
const pageIn = (l: Locale) => absolute(localeHome(l) + path);
const canonical = pageIn(locale);
const title = `${Astro.props.title ?? t.meta.title} · ${brandName}`;
const description = Astro.props.description ?? t.meta.description;
const isHome = path === "";
// The shared-link preview: JPEG, which every app that unfurls links can read.
const shareSource = shareImageFor(locale);
const share = shareSource && (await getImage({ src: shareSource, format: "jpg", quality: 85 }));
// The product and its plans are described once, on the home page.
const jsonLd = isHome ? toJsonLd(structuredData(t, locale, await loadPlans(), { home: absolute("/"), page: canonical })) : null;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(BLOCK_SEARCH_ENGINES || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={messagesFor(l).htmlLang} href={pageIn(l)} />)}
    <link rel="alternate" hreflang="x-default" href={pageIn(defaultLocale)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1f23" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={messagesFor(l).ogLocale} />)
    }
    {
      shareSource && share && (
        <Fragment>
          <meta property="og:image" content={absolute(share.src)} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(shareSource.width)} />
          <meta property="og:image:height" content={String(shareSource.height)} />
          <meta property="og:image:alt" content={t.screens.calendar} />
          <meta name="twitter:image" content={absolute(share.src)} />
        </Fragment>
      )
    }
    <meta name="twitter:card" content={share ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <slot />
  </body>
</html>
