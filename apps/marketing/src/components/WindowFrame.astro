---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<!-- A desktop window around a CMS screenshot: a thin title bar, then the shot. -->
<div class:list={["overflow-hidden rounded-xl bg-base-100 shadow-2xl ring-1 ring-base-300 md:rounded-2xl", className]}>
  <div class="flex h-7 items-center gap-1.5 border-b border-base-300 bg-base-200 px-3 md:h-9 md:px-4" aria-hidden="true">
    <span class="size-2.5 rounded-full bg-base-300"></span>
    <span class="size-2.5 rounded-full bg-base-300"></span>
    <span class="size-2.5 rounded-full bg-base-300"></span>
  </div>
  <slot />
</div>
