---
import { brandName } from "../lib/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<!-- The mark: an ink tile with a tick, and the highlighter's dot. -->
<span class:list={["inline-flex items-center gap-2 text-lg font-semibold tracking-tight", className]}>
  <svg class="size-7" viewBox="0 0 28 28" aria-hidden="true">
    <rect width="28" height="28" rx="8" class="fill-primary"></rect>
    <path
      d="m8.5 14.5 3.5 3.5 7.5-8"
      fill="none"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-primary-content"></path>
    <circle cx="22.5" cy="5.5" r="3.5" class="fill-accent stroke-base-100" stroke-width="1.5"></circle>
  </svg>
  <span>{brandName}</span>
</span>
