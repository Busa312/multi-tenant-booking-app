---
import { contactPath, localeHome, type Locale, type Messages } from "../i18n";
import { brandName, cmsUrl, contactEmail } from "../lib/site";
import LanguageLinks from "./LanguageLinks.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
  t: Messages;
  /** The page under the language's home, for the language links (empty = home). */
  path?: string;
}

const { locale, t, path = "" } = Astro.props;
const year = new Date().getFullYear();
const home = localeHome(locale);
---

<footer class="border-t border-base-300 bg-base-200 px-4 py-12 text-sm sm:px-6">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 md:flex-row md:items-start md:justify-between">
    <div>
      <Logo />
      <p class="mt-3 text-base-content/60">{t.footer.tagline}</p>
    </div>
    <ul class="grid grid-cols-2 gap-x-12 gap-y-3 text-base-content/70 sm:grid-cols-3">
      <li><a class="hover:text-base-content" href={`${home}#features`}>{t.nav.features}</a></li>
      <li><a class="hover:text-base-content" href={`${home}#pricing`}>{t.nav.pricing}</a></li>
      <li><a class="hover:text-base-content" href={`${home}#faq`}>{t.nav.faq}</a></li>
      <li><a class="hover:text-base-content" href={cmsUrl}>{t.nav.signIn}</a></li>
      <li><a class="hover:text-base-content" href={contactPath(locale)}>{t.footer.contact}</a></li>
      <li><a class="hover:text-base-content" href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
    </ul>
  </div>
  <div class="mx-auto mt-12 flex max-w-6xl flex-col gap-4 border-t border-base-300 pt-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-base-content/50">© {year} {brandName}. {t.footer.rights}</p>
    <LanguageLinks locale={locale} path={path} label={t.nav.language} variant="names" />
  </div>
</footer>
