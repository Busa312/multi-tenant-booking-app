---
import { languageNames, localeHome, locales, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** The switcher's accessible name, in the page's language. */
  label: string;
  /** `codes`: KA · EN · RU, the same width in every language, so the header never shifts. `names`: each language written out. */
  variant: "codes" | "names";
  /** This page under each language's home ("contact/"), so switching keeps the visitor on it. */
  path?: string;
  class?: string;
}

const { locale, label, variant, path = "", class: className } = Astro.props;
---

<!-- Plain links between the language homes, like the booking sites' switcher (R160). -->
<nav aria-label={label} class:list={["flex items-center", variant === "codes" ? "gap-0.5" : "flex-wrap gap-x-4 gap-y-1", className]}>
  {
    locales.map((code) => (
      <a
        href={localeHome(code) + path}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? "page" : undefined}
        title={variant === "codes" ? languageNames[code] : undefined}
        class:list={[
          variant === "codes" ? "btn btn-ghost btn-xs w-9 font-medium uppercase" : "hover:text-base-content",
          code === locale ? "text-base-content" : "text-base-content/55",
        ]}
      >
        {variant === "codes" ? code : languageNames[code]}
      </a>
    ))
  }
</nav>
