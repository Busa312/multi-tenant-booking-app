---
import type { FeatureCopy } from "../i18n/types";
import Icon from "./Icon.astro";

interface Props {
  feature: FeatureCopy;
  wide?: boolean;
}

const { feature, wide = false } = Astro.props;
---

<article class:list={["reveal flex flex-col rounded-box bg-base-200 p-7 md:p-9", { "lg:col-span-2": wide }]}>
  <span class="grid size-12 place-items-center rounded-2xl bg-base-100">
    <Icon name={feature.icon} class="size-6" />
  </span>
  <h3 class={wide ? "mt-10 text-2xl font-semibold tracking-tight md:text-3xl" : "mt-10 text-xl font-semibold tracking-tight"}>
    {feature.title}
  </h3>
  <p class={wide ? "mt-3 max-w-md text-lg leading-relaxed text-base-content/60" : "mt-3 leading-relaxed text-base-content/60"}>
    {feature.body}
  </p>
</article>
