# Marketing site (R560). All read at build time — change one, redeploy.

# The site's own origin: canonical links, hreflang and the sitemap use it.
SITE_URL=https://book-it.ge
# Staging only (bukme.website): pages say noindex and no sitemap is offered.
BLOCK_SEARCH_ENGINES=false
# The API: the offered plans are read from it at build time (GET /plans), and
# the contact form (R580) posts to it.
API_URL=https://api.book-it.ge
# Where "Sign in" goes.
PUBLIC_CMS_URL=https://cms.book-it.ge
