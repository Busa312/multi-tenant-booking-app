# Owner/migration connection — used by `prisma migrate`/`prisma generate` only.
# Table owners bypass Postgres RLS, so the running API must NOT use this one.
# Port 5434 (not 5432) on the host side — see docker-compose.yml.
DATABASE_URL="postgresql://booking:booking@localhost:5434/booking?schema=public"

# Runtime connection for the API itself: a non-superuser, non-owner role
# (created in docker/postgres/init.sql) so RLS policies actually apply.
APP_DATABASE_URL="postgresql://booking_app:booking_app@localhost:5434/booking?schema=public"

REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
PORT=3001

# Shared secret for staff-only tenant onboarding (POST /internal/onboarding/tenants),
# sent as the x-internal-api-key header. Not used by the CMS or public-site apps.
INTERNAL_API_KEY="change-me-in-production"

# Used to trigger apps/public-site's on-demand ISR revalidation after a CMS
# tenant-colors save (POST {PUBLIC_SITE_URL}/api/revalidate). Base domain is
# used to reconstruct a tenant's subdomain host (e.g. "acme.bukme.website")
# since public-site resolves tenants by Host header, not tenant_id.
PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_SITE_BASE_DOMAIN="bukme.website"
REVALIDATE_SECRET="change-me-in-production"

# The CMS's origin: the only site allowed to call this API from a browser
# (CORS), and the base of password-reset links (R310). CORS_ORIGINS, if set,
# overrides the CORS part with a comma-separated list.
CMS_URL="http://localhost:5173"
# CORS_ORIGINS="https://cms.example.com"

# "production" turns Swagger (/docs) off unless ENABLE_SWAGGER="true", and
# stops password-reset links being written to the log.
NODE_ENV="development"
# ENABLE_SWAGGER="true"

# Error tracking (system_design.md §12a) — leave empty to disable.
SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""

# R320: the CMS session cookie (httpOnly, SameSite=Strict, path /cms). The CMS
# and the API must share a registrable domain in production (e.g.
# cms.example.com + api.example.com) or the browser won't send it.
# COOKIE_DOMAIN unset = this API's host only, which is the safest scope.
# COOKIE_DOMAIN=""
# COOKIE_SAME_SITE="strict"   # only "none" if the domains can't be shared
# COOKIE_SECURE="true"        # implied by NODE_ENV=production

# R330: how far to trust X-Forwarded-For — the platform's proxy hop count
# ("1" behind one load balancer) or its addresses/CIDRs. Unset trusts nothing
# (local). Never "true": clients could then choose their own rate-limit address.
# TRUST_PROXY="1"

# Shared with apps/public-site: lets its server name the visitor it's calling
# for (X-Visitor-IP), so public rate limits count per visitor. Any long random
# string; without it, public calls are counted per salon only.
PUBLIC_SITE_API_KEY=""
