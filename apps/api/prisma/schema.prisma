// Data model mirrors "Unified Requirements and Data Model.md" exactly.
// RLS policies + the partial-unique-owner-per-tenant constraint aren't expressible
// in Prisma's schema DSL and are added by hand in prisma/migrations/0002_rls/migration.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantUserRole {
  owner
  professional

  @@map("tenant_user_role")
}

enum AppointmentStatus {
  booked
  cancelled
  completed
  no_show

  @@map("appointment_status")
}

model Tenant {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  timezone         String
  subdomain        String    @unique
  customDomain     String?   @unique @map("custom_domain")
  domainVerifiedAt DateTime? @map("domain_verified_at") @db.Timestamptz
  configJson       Json      @default("{}") @map("config_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  locations       Location[]
  professionals   Professional[]
  tenantUsers     TenantUser[]
  services        Service[]
  serviceProfessionals ServiceProfessional[]
  businessHours   BusinessHours[]
  timeOff         TimeOff[]
  appointments    Appointment[]
  appointmentServices AppointmentService[]

  @@map("tenant")
}

/// A tenant's physical branch. A tenant may have none (a single salon with no
/// address worth modelling), one, or several — and locations are a *bookable*
/// dimension, not decoration: the branch a customer picks narrows which
/// professionals they can book, and is recorded on the appointment so the
/// confirmation and magic link can say where to turn up.
///
/// Per-location business hours deliberately don't exist: a professional belongs
/// to one location and already carries their own BusinessHours rows, so hours
/// are location-scoped by consequence. See the data-model doc's Location section
/// for what that can't express and the additive path out of it.
model Location {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  // Non-default locales only; the plain column above holds the default one.
  // See "Localized content" in the data-model doc.
  nameI18n        Json?    @map("name_i18n")
  addressLine     String   @map("address_line")
  addressLineI18n Json?    @map("address_line_i18n")
  city            String?
  phone           String?
  // Both set or neither — a lone coordinate can't produce a map link. Decimal
  // rather than Float for the same reason price is: no binary rounding drift.
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  position        Int      @db.SmallInt
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals Professional[]
  appointments  Appointment[]

  @@index([tenantId])
  @@map("location")
}

model Professional {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  // R160: non-default locales only — `name` below holds the default one, the
  // same split service and location names use.
  nameI18n  Json?    @map("name_i18n")
  // R180: null = works at every location — the same "applies everywhere" sense
  // that a null professional_id has on BusinessHours/TimeOff, not "unknown".
  // Every professional of a tenant with no locations sits at null, which is why
  // introducing locations disturbs no existing tenant.
  locationId String?  @map("location_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull, not Restrict: a location can only be deleted when it never held an
  // appointment (R190), and a professional left behind by that reverts to the
  // "works everywhere" default rather than blocking the delete.
  location             Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tenantUser           TenantUser?
  serviceProfessionals ServiceProfessional[]
  businessHours        BusinessHours[]
  timeOff              TimeOff[]
  appointments         Appointment[]

  @@index([tenantId])
  @@map("professional")
}

model TenantUser {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  professionalId       String?        @unique @map("professional_id") @db.Uuid
  email                String
  passwordHash         String         @map("password_hash")
  role                 TenantUserRole
  isActive             Boolean        @default(true) @map("is_active")
  // Set on invite (R50), cleared once the professional sets a real password.
  // Hashed (sha256, not bcrypt — a high-entropy random token, not a
  // low-entropy secret, so bcrypt's deliberate slowness buys nothing here).
  inviteTokenHash      String?        @unique @map("invite_token_hash")
  inviteTokenExpiresAt DateTime?      @map("invite_token_expires_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt          DateTime?      @map("last_login_at") @db.Timestamptz

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional        Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("tenant_user")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  // R160: non-default locales only — `name` above holds the default one and
  // stays the queryable column. See "Localized content" in the data-model doc.
  nameI18n        Json?    @map("name_i18n")
  description     String?  @db.Text
  descriptionI18n Json?    @map("description_i18n")
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceProfessionals ServiceProfessional[]
  appointmentServices  AppointmentService[]

  @@index([tenantId])
  @@map("service")
}

model ServiceProfessional {
  serviceId      String @map("service_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([tenantId])
  @@map("service_professional")
}

model BusinessHours {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week") @db.SmallInt
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, professionalId, dayOfWeek])
  @@map("business_hours")
}

model TimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String?  @map("professional_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz
  endAt          DateTime @map("end_at") @db.Timestamptz
  reason         String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, professionalId, startAt, endAt])
  @@map("time_off")
}

model Appointment {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  professionalId       String?           @map("professional_id") @db.Uuid
  // R150: the branch this was booked at. Null = the tenant has no locations.
  locationId           String?           @map("location_id") @db.Uuid
  userName             String            @map("user_name")
  phoneNumber          String            @map("phone_number")
  email                String
  startAt              DateTime          @map("start_at") @db.Timestamptz
  endAt                DateTime          @map("end_at") @db.Timestamptz
  price                Decimal           @db.Decimal(10, 2)
  status               AppointmentStatus @default(booked)
  accessTokenHash      String?           @unique @map("access_token_hash")
  accessTokenExpiresAt DateTime?         @map("access_token_expires_at") @db.Timestamptz
  // null = the customer booked it themselves on the public site; set = a staff
  // member created it from the CMS. The only way to tell the two origins apart,
  // which is what explains a row having no magic-link token and who to ask
  // about an availability override.
  createdByUserId      String?           @map("created_by_user_id") @db.Uuid
  // Free-text context a phone booking carries ("regular client", "arriving late").
  notes                String?           @db.Text
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional  Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  // Restrict, for the same reason AppointmentService.serviceId is: this FK is
  // the database-level backstop behind the 409 in locations.controller.ts.
  // SetNull would let deleting a branch silently erase where every appointment
  // there ever happened — so a location with history deactivates instead (R190).
  location      Location?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdByUser TenantUser?          @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  services      AppointmentService[]

  @@index([tenantId, startAt])
  @@index([tenantId, professionalId, startAt])
  @@map("appointment")
}

// The services one appointment covers. An appointment holds one or more (the
// requirements doc's "User can choose one or more services"); they run as one
// contiguous block with one professional, so `end_at` is start + the sum of
// these durations and `Appointment.price` is the sum of these prices.
//
// `duration_minutes` and `price` are snapshots taken when the line was added,
// for the same reason Appointment.price always was (R40): re-pricing history
// when a service changes would rewrite what a customer was quoted. `name` is
// deliberately NOT snapshotted — a rename is normally a correction, and the FK
// is still the service's identity.
model AppointmentService {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid
  // Order the services were chosen in — what the CMS lists them by. A surrogate
  // PK rather than a composite one on (appointment, service) so that allowing
  // the same service twice later is a validation change, not a migration.
  position        Int     @db.SmallInt
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(10, 2)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: this FK is the database-level backstop behind the
  // 409 in services.controller.ts. Cascading here would let deleting a service
  // silently erase the history of every appointment that ever used it.
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, position])
  @@index([tenantId])
  @@index([serviceId])
  @@index([appointmentId])
  @@map("appointment_service")
}
