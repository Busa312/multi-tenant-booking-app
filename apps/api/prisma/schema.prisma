// Data model mirrors "Unified Requirements and Data Model.md" exactly.
// RLS policies + the partial-unique-owner-per-tenant constraint aren't expressible
// in Prisma's schema DSL and are added by hand in prisma/migrations/0002_rls/migration.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantUserRole {
  owner
  professional

  @@map("tenant_user_role")
}

enum AppointmentStatus {
  booked
  cancelled
  completed
  no_show

  @@map("appointment_status")
}

model Tenant {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  timezone         String
  subdomain        String    @unique
  customDomain     String?   @unique @map("custom_domain")
  domainVerifiedAt DateTime? @map("domain_verified_at") @db.Timestamptz
  configJson       Json      @default("{}") @map("config_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  professionals   Professional[]
  tenantUsers     TenantUser[]
  services        Service[]
  serviceProfessionals ServiceProfessional[]
  businessHours   BusinessHours[]
  timeOff         TimeOff[]
  appointments    Appointment[]
  appointmentServices AppointmentService[]

  @@map("tenant")
}

model Professional {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUser           TenantUser?
  serviceProfessionals ServiceProfessional[]
  businessHours        BusinessHours[]
  timeOff              TimeOff[]
  appointments         Appointment[]

  @@index([tenantId])
  @@map("professional")
}

model TenantUser {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  professionalId       String?        @unique @map("professional_id") @db.Uuid
  email                String
  passwordHash         String         @map("password_hash")
  role                 TenantUserRole
  isActive             Boolean        @default(true) @map("is_active")
  // Set on invite (R50), cleared once the professional sets a real password.
  // Hashed (sha256, not bcrypt — a high-entropy random token, not a
  // low-entropy secret, so bcrypt's deliberate slowness buys nothing here).
  inviteTokenHash      String?        @unique @map("invite_token_hash")
  inviteTokenExpiresAt DateTime?      @map("invite_token_expires_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt          DateTime?      @map("last_login_at") @db.Timestamptz

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional        Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("tenant_user")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  description     String?  @db.Text
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceProfessionals ServiceProfessional[]
  appointmentServices  AppointmentService[]

  @@index([tenantId])
  @@map("service")
}

model ServiceProfessional {
  serviceId      String @map("service_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([tenantId])
  @@map("service_professional")
}

model BusinessHours {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week") @db.SmallInt
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, professionalId, dayOfWeek])
  @@map("business_hours")
}

model TimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String?  @map("professional_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz
  endAt          DateTime @map("end_at") @db.Timestamptz
  reason         String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, professionalId, startAt, endAt])
  @@map("time_off")
}

model Appointment {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  professionalId       String?           @map("professional_id") @db.Uuid
  userName             String            @map("user_name")
  phoneNumber          String            @map("phone_number")
  email                String
  startAt              DateTime          @map("start_at") @db.Timestamptz
  endAt                DateTime          @map("end_at") @db.Timestamptz
  price                Decimal           @db.Decimal(10, 2)
  status               AppointmentStatus @default(booked)
  accessTokenHash      String?           @unique @map("access_token_hash")
  accessTokenExpiresAt DateTime?         @map("access_token_expires_at") @db.Timestamptz
  // null = the customer booked it themselves on the public site; set = a staff
  // member created it from the CMS. The only way to tell the two origins apart,
  // which is what explains a row having no magic-link token and who to ask
  // about an availability override.
  createdByUserId      String?           @map("created_by_user_id") @db.Uuid
  // Free-text context a phone booking carries ("regular client", "arriving late").
  notes                String?           @db.Text
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional  Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  createdByUser TenantUser?          @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  services      AppointmentService[]

  @@index([tenantId, startAt])
  @@index([tenantId, professionalId, startAt])
  @@map("appointment")
}

// The services one appointment covers. An appointment holds one or more (the
// requirements doc's "User can choose one or more services"); they run as one
// contiguous block with one professional, so `end_at` is start + the sum of
// these durations and `Appointment.price` is the sum of these prices.
//
// `duration_minutes` and `price` are snapshots taken when the line was added,
// for the same reason Appointment.price always was (R40): re-pricing history
// when a service changes would rewrite what a customer was quoted. `name` is
// deliberately NOT snapshotted — a rename is normally a correction, and the FK
// is still the service's identity.
model AppointmentService {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid
  // Order the services were chosen in — what the CMS lists them by. A surrogate
  // PK rather than a composite one on (appointment, service) so that allowing
  // the same service twice later is a validation change, not a migration.
  position        Int     @db.SmallInt
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(10, 2)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: this FK is the database-level backstop behind the
  // 409 in services.controller.ts. Cascading here would let deleting a service
  // silently erase the history of every appointment that ever used it.
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, position])
  @@index([tenantId])
  @@index([serviceId])
  @@index([appointmentId])
  @@map("appointment_service")
}
