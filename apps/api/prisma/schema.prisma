// Data model mirrors "Unified Requirements and Data Model.md" exactly.
// RLS policies + the partial-unique-owner-per-tenant constraint aren't expressible
// in Prisma's schema DSL and are added by hand in prisma/migrations/0002_rls/migration.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantUserRole {
  owner
  professional

  @@map("tenant_user_role")
}

enum AppointmentStatus {
  booked
  cancelled
  completed
  no_show

  @@map("appointment_status")
}

model Tenant {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  timezone         String
  subdomain        String    @unique
  customDomain     String?   @unique @map("custom_domain")
  domainVerifiedAt DateTime? @map("domain_verified_at") @db.Timestamptz
  configJson       Json      @default("{}") @map("config_json")
  // R220: longest idle gap (minutes, 0–60) between consecutive segments of a
  // visit. A booking rule, so a column rather than presentation config_json.
  // The 0–60 range is a CHECK constraint in the migration.
  maxVisitGapMinutes Int     @default(0) @map("max_visit_gap_minutes") @db.SmallInt
  // R280–R300: what customers may do online (staff aren't bound by them).
  // Ranges are CHECK constraints in the migration.
  minBookingNoticeMinutes Int @default(0) @map("min_booking_notice_minutes") @db.SmallInt
  maxBookingAdvanceDays   Int @default(365) @map("max_booking_advance_days") @db.SmallInt
  changeCutoffHours       Int @default(0) @map("change_cutoff_hours") @db.SmallInt
  // R440: false = customers book a service, not a person (a car wash): the
  // booking site never offers or names a professional.
  customersChooseProfessional Boolean @default(true) @map("customers_choose_professional")
  // R610: hours before a visit its reminder text goes out; 0 = off. One of
  // 0/2/12/24/48 (CHECK constraint in the migration).
  reminderHoursBefore   Int       @default(24) @map("reminder_hours_before") @db.SmallInt
  // R630: kept free before and after each home visit (0/15/30/45/60/90, CHECK),
  // and the fee charged once per home visit whose services it applies to (0 = none).
  travelBufferMinutes   Int       @default(30) @map("travel_buffer_minutes") @db.SmallInt
  homeVisitFee          Decimal   @default(0) @map("home_visit_fee") @db.Decimal(10, 2)
  // R420: the guided setup's own state. Whether a step is done is read from
  // the salon's data; only skips and finishing/dismissing are kept.
  onboardingSkipped     String[]  @default([]) @map("onboarding_skipped")
  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at") @db.Timestamptz
  // Finishing (the last step) is not the same as hiding the dashboard card.
  onboardingFinishedAt  DateTime? @map("onboarding_finished_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  locations       Location[]
  professionals   Professional[]
  tenantUsers     TenantUser[]
  services        Service[]
  serviceProfessionals ServiceProfessional[]
  businessHours   BusinessHours[]
  timeOff         TimeOff[]
  appointments    Appointment[]
  appointmentServices AppointmentService[]
  visits          Visit[]
  slotHolds       SlotHold[]
  blockedPhones   BlockedPhone[]
  subscription    Subscription?
  subscriptionPayments SubscriptionPayment[]
  smsMessages     SmsMessage[]
  serviceCategories ServiceCategory[]
  pushSubscriptions PushSubscription[]

  @@map("tenant")
}

/// A tenant's physical branch. A tenant may have none (a single salon with no
/// address worth modelling), one, or several — and locations are a *bookable*
/// dimension, not decoration: the branch a customer picks narrows which
/// professionals they can book, and is recorded on the appointment so the
/// confirmation and magic link can say where to turn up.
///
/// Per-location business hours deliberately don't exist: a professional belongs
/// to one location and already carries their own BusinessHours rows, so hours
/// are location-scoped by consequence. See the data-model doc's Location section
/// for what that can't express and the additive path out of it.
model Location {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  // Non-default locales only; the plain column above holds the default one.
  // See "Localized content" in the data-model doc.
  nameI18n        Json?    @map("name_i18n")
  addressLine     String   @map("address_line")
  addressLineI18n Json?    @map("address_line_i18n")
  city            String?
  cityI18n        Json?    @map("city_i18n")
  phone           String?
  // Both set or neither — a lone coordinate can't produce a map link. Decimal
  // rather than Float for the same reason price is: no binary rounding drift.
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  position        Int      @db.SmallInt
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals Professional[]
  appointments  Appointment[]

  @@index([tenantId])
  @@map("location")
}

model Professional {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  // R160: non-default locales only — `name` below holds the default one, the
  // same split service and location names use.
  nameI18n  Json?    @map("name_i18n")
  // R180: null = works at every location — the same "applies everywhere" sense
  // that a null professional_id has on BusinessHours/TimeOff, not "unknown".
  // Every professional of a tenant with no locations sits at null, which is why
  // introducing locations disturbs no existing tenant.
  locationId String?  @map("location_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull, not Restrict: a location can only be deleted when it never held an
  // appointment (R190), and a professional left behind by that reverts to the
  // "works everywhere" default rather than blocking the delete.
  location             Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tenantUser           TenantUser?
  serviceProfessionals ServiceProfessional[]
  businessHours        BusinessHours[]
  timeOff              TimeOff[]
  appointments         Appointment[]
  slotHolds            SlotHold[]

  @@index([tenantId])
  @@map("professional")
}

model TenantUser {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  professionalId       String?        @unique @map("professional_id") @db.Uuid
  email                String
  passwordHash         String         @map("password_hash")
  role                 TenantUserRole
  isActive             Boolean        @default(true) @map("is_active")
  // Set on invite (R50), cleared once the professional sets a real password.
  // Hashed (sha256, not bcrypt — a high-entropy random token, not a
  // low-entropy secret, so bcrypt's deliberate slowness buys nothing here).
  inviteTokenHash      String?        @unique @map("invite_token_hash")
  inviteTokenExpiresAt DateTime?      @map("invite_token_expires_at") @db.Timestamptz
  // R320: in every JWT; bumping it ends all of this user's sessions at once.
  sessionVersion       Int            @default(0) @map("session_version")
  // R310: forgot-password link, hashed like the invite token. Single use.
  passwordResetTokenHash String?      @unique @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime?    @map("password_reset_expires_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt          DateTime?      @map("last_login_at") @db.Timestamptz

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional        Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")
  blockedPhones       BlockedPhone[]
  pushSubscriptions   PushSubscription[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("tenant_user")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  // R160: non-default locales only — `name` above holds the default one and
  // stays the queryable column. See "Localized content" in the data-model doc.
  nameI18n        Json?    @map("name_i18n")
  description     String?  @db.Text
  descriptionI18n Json?    @map("description_i18n")
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  /// R520: `price` is a starting price ("from 15 ₾").
  priceFrom       Boolean  @default(false) @map("price_from")
  /// R510: null = uncategorized.
  categoryId      String?  @map("category_id") @db.Uuid
  /// R510: order within its category.
  position        Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  /// R630: business | customer (at the customer's address) | either (CHECK).
  place           String   @default("business")
  /// R630: the salon's home-visit fee is charged when this is booked at the
  /// customer's address (once per visit, however many services it applies to).
  homeVisitFeeApplies Boolean @default(true) @map("home_visit_fee_applies")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceProfessionals ServiceProfessional[]
  appointmentServices  AppointmentService[]

  @@index([tenantId])
  @@map("service")
}

model ServiceProfessional {
  serviceId      String @map("service_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([tenantId])
  @@map("service_professional")
}

model BusinessHours {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week") @db.SmallInt
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time
  /// R460: a professional's weekday off; times are 00:00–00:00 (CHECK in the migration).
  isDayOff       Boolean  @default(false) @map("is_day_off")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, professionalId, dayOfWeek])
  @@map("business_hours")
}

model TimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String?  @map("professional_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz
  endAt          DateTime @map("end_at") @db.Timestamptz
  reason         String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, professionalId, startAt, endAt])
  @@map("time_off")
}

/// R200: one customer booking from the public site. Groups the appointments —
/// one per professional segment — that the customer sees as a single booking,
/// and owns the magic link that manages all of them together (R230). Its status
/// is derived from its appointments rather than stored.
model Visit {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  accessTokenHash      String?   @unique @map("access_token_hash")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@map("visit")
}

/// R380: a phone number this salon has stopped from booking online. One
/// salon's decision: the same number books freely everywhere else, and RLS
/// keeps each salon's list to itself.
model BlockedPhone {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  // As staff typed it, for showing back to them.
  phoneNumber     String   @map("phone_number")
  // The number in one canonical spelling (common/phone-key.ts) — what blocks
  // are matched and de-duplicated on.
  phoneKey        String   @map("phone_key")
  reason          String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser TenantUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, phoneKey])
  @@index([tenantId])
  @@map("blocked_phone")
}

/// R250: a customer's 10-minute claim on one segment of the time they picked.
/// The segments of one hold share `holdId`; expired rows are ignored, not
/// relied on to be deleted.
model SlotHold {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  holdId         String   @map("hold_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz
  endAt          DateTime @map("end_at") @db.Timestamptz
  // R630: a held home visit keeps its travel time free too
  travelMinutes  Int      @default(0) @map("travel_minutes") @db.SmallInt
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([holdId])
  @@index([professionalId, startAt])
  @@map("slot_hold")
}

model Appointment {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  professionalId       String?           @map("professional_id") @db.Uuid
  // R150: the branch this was booked at. Null = the tenant has no locations.
  locationId           String?           @map("location_id") @db.Uuid
  userName             String            @map("user_name")
  phoneNumber          String            @map("phone_number")
  // The number in one canonical spelling (common/phone-key.ts): what a
  // customer is matched on. `phoneNumber` stays as typed, for showing and texting.
  phoneKey             String            @map("phone_key")
  email                String
  startAt              DateTime          @map("start_at") @db.Timestamptz
  endAt                DateTime          @map("end_at") @db.Timestamptz
  price                Decimal           @db.Decimal(10, 2)
  status               AppointmentStatus @default(booked)
  // R200: the customer visit this appointment is one segment of. Null for a
  // staff-created booking, which never had a magic link (R70). The link itself
  // lives on the visit, so every segment shares it (R230).
  visitId              String?           @map("visit_id") @db.Uuid
  // null = the customer booked it themselves on the public site; set = a staff
  // member created it from the CMS. The only way to tell the two origins apart,
  // which is what explains a row having no magic-link token and who to ask
  // about an availability override.
  createdByUserId      String?           @map("created_by_user_id") @db.Uuid
  // Free-text context a phone booking carries ("regular client", "arriving late").
  notes                String?           @db.Text
  // R610: when its reminder went out (or was claimed for sending), and when
  // the customer confirmed through their link. Moving it clears both.
  reminderSentAt       DateTime?         @map("reminder_sent_at") @db.Timestamptz
  confirmedAt          DateTime?         @map("confirmed_at") @db.Timestamptz
  // R630: business | customer. At the customer's address, the address is set
  // (CHECK: exactly then), travel time is kept free around it, and the visit's
  // first segment carries the home-visit fee. All snapshotted at booking.
  place                  String          @default("business")
  customerAddress        String?         @map("customer_address")
  customerAddressDetails String?         @map("customer_address_details")
  customerAddressNote    String?         @map("customer_address_note")
  travelMinutes          Int             @default(0) @map("travel_minutes") @db.SmallInt
  homeVisitFee           Decimal         @default(0) @map("home_visit_fee") @db.Decimal(10, 2)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional  Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  // Restrict, for the same reason AppointmentService.serviceId is: this FK is
  // the database-level backstop behind the 409 in locations.controller.ts.
  // SetNull would let deleting a branch silently erase where every appointment
  // there ever happened — so a location with history deactivates instead (R190).
  location      Location?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdByUser TenantUser?          @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  services      AppointmentService[]
  // Restrict: a visit is the customer's booking record and is never deleted
  // while it has segments — cancelling flips statuses, it doesn't remove rows.
  visit         Visit?               @relation(fields: [visitId], references: [id], onDelete: Restrict)

  @@index([tenantId, startAt])
  @@index([visitId])
  @@index([tenantId, professionalId, startAt])
  // A customer's appointments by phone: no-show history (R360), new vs returning (R370)
  @@index([tenantId, phoneKey, startAt])
  @@map("appointment")
}

// The services one appointment covers. An appointment holds one or more (the
// requirements doc's "User can choose one or more services"); they run as one
// contiguous block with one professional, so `end_at` is start + the sum of
// these durations and `Appointment.price` is the sum of these prices.
//
// `duration_minutes` and `price` are snapshots taken when the line was added,
// for the same reason Appointment.price always was (R40): re-pricing history
// when a service changes would rewrite what a customer was quoted. `name` is
// deliberately NOT snapshotted — a rename is normally a correction, and the FK
// is still the service's identity.
model AppointmentService {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid
  // Order the services were chosen in — what the CMS lists them by. A surrogate
  // PK rather than a composite one on (appointment, service) so that allowing
  // the same service twice later is a validation change, not a migration.
  position        Int     @db.SmallInt
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(10, 2)
  /// R520: snapshot of Service.priceFrom.
  priceFrom       Boolean @default(false) @map("price_from")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: this FK is the database-level backstop behind the
  // 409 in services.controller.ts. Cascading here would let deleting a service
  // silently erase the history of every appointment that ever used it.
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, position])
  @@index([tenantId])
  @@index([serviceId])
  @@index([appointmentId])
  @@map("appointment_service")
}

/// R470/R480: one per tenant. Status is derived (billing/subscription-status.ts), never stored.
model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @unique @map("tenant_id") @db.Uuid
  planId            String    @map("plan_id")
  nextPlanId        String?   @map("next_plan_id")
  trialEndsAt       DateTime  @map("trial_ends_at") @db.Timestamptz
  paidThrough       DateTime? @map("paid_through") @db.Timestamptz
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  free              Boolean   @default(false)
  /// Flitt's saved-card token: useless without the platform's merchant key.
  rectoken          String?
  cardMasked        String?   @map("card_masked")
  cardBrand         String?   @map("card_brand")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  retryAt           DateTime? @map("retry_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan  @relation("CurrentPlan", fields: [planId], references: [id], onDelete: Restrict)
  nextPlan SubscriptionPlan? @relation("NextPlan", fields: [nextPlanId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("subscription")
}

/// R470/R550: the plans, edited by the platform admin. Platform-wide: no tenant_id, no RLS.
model SubscriptionPlan {
  id              String   @id
  /// R550: the plan's name in English; nameI18n holds Georgian and Russian ({"ka": …, "ru": …}).
  name            String
  nameI18n        Json?    @map("name_i18n")
  price           Decimal  @db.Decimal(10, 2)
  /// R540: active locations allowed; null = no limit.
  maxLocations    Int?     @map("max_locations")
  prioritySupport Boolean  @default(false) @map("priority_support")
  offered         Boolean  @default(false)
  position        Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions     Subscription[]        @relation("CurrentPlan")
  nextSubscriptions Subscription[]        @relation("NextPlan")
  payments          SubscriptionPayment[]

  @@map("subscription_plan")
}

/// R470: every payment attempt — the invoices.
model SubscriptionPayment {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// "<tenant id>.<kind>.<suffix>": a callback names its tenant.
  orderId        String    @unique @map("order_id")
  kind           String
  planId         String?   @map("plan_id")
  amount         Decimal   @db.Decimal(10, 2)
  periodStart    DateTime? @map("period_start") @db.Timestamptz
  periodEnd      DateTime? @map("period_end") @db.Timestamptz
  status         String    @default("pending")
  flittPaymentId String?   @map("flitt_payment_id")
  cardMasked     String?   @map("card_masked")
  failureReason  String?   @map("failure_reason")
  /// R500: texts beyond the allowance in the month before periodStart, charged with this renewal.
  /// Historical (R500's former per-plan allowance): no longer written.
  extraTexts       Int       @default(0) @map("extra_texts")
  extraTextsAmount Decimal   @default(0) @map("extra_texts_amount") @db.Decimal(10, 2)
  extraTextsFrom   DateTime? @map("extra_texts_from") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  settledAt      DateTime? @map("settled_at") @db.Timestamptz

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("subscription_payment")
}

/// R500: one row per text the SMS provider accepted — the usage count. No number, no text.
model SmsMessage {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  kind     String
  parts    Int
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sentAt])
  @@map("sms_message")
}

/// R620: one device a CMS user switched push notifications on for.
model PushSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenantUserId   String    @map("tenant_user_id") @db.Uuid
  // The push service's URL for this device: what identifies a subscription.
  endpoint       String    @unique
  p256dh         String
  auth           String
  // en | ka | ru — the language its notifications are written in (R570)
  locale         String
  // The user's session_version when it was switched on: a bump since (R320)
  // means it is skipped and deleted rather than pushed to.
  sessionVersion Int       @map("session_version")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUser TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, tenantUserId])
  @@map("push_subscription")
}

/// R510: how a salon groups its price list, in its own order.
model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  // R160: non-default locales only, as on Service.
  nameI18n  Json?    @map("name_i18n")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([tenantId])
  @@map("service_category")
}

/// R580: a business asking to get started, from the marketing site's contact
/// page. Platform-wide: no tenant_id, no RLS — only the platform admin reads it.
model ContactRequest {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  business  String
  phone     String
  email     String?
  message   String?
  locale    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  handledAt DateTime? @map("handled_at") @db.Timestamptz

  @@index([createdAt])
  @@map("contact_request")
}
