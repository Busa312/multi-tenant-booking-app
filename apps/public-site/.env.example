API_URL="http://localhost:3001"

# Shared secret checked by POST /api/revalidate — must match apps/api's
# REVALIDATE_SECRET, which apps/api sends after a CMS tenant-colors save.
REVALIDATE_SECRET="change-me-in-production"

# Origin allowed to postMessage draft colors into an embedded preview iframe
# (apps/cms's BrandingSettings page) — must be exact (scheme+host+port, no
# trailing slash). NEXT_PUBLIC_ prefix required so it's readable client-side.
NEXT_PUBLIC_CMS_ORIGIN="http://localhost:5173"

# Used to build each tenant's canonical URL — the one hostname their site should
# be known by. Must match apps/api's PUBLIC_SITE_BASE_DOMAIN, since that's what
# RevalidationService reconstructs subdomain hosts from.
#
# A tenant with a verified custom domain canonicalises to that instead; this is
# the fallback for everyone else. Derived from tenant data rather than the
# request's Host header, which is attacker-controlled — see src/lib/site-url.ts.
PUBLIC_SITE_BASE_DOMAIN="bukme.website"
# "http" locally; "https" everywhere real. This builds every canonical URL and
# og:url, so an "http" value on an https deployment emits wrong canonicals.
PUBLIC_SITE_PROTOCOL="http"

# Set to "true" on staging/test deployments to force `noindex` for every tenant,
# regardless of how complete their content is. Without it a well-configured
# tenant on a test box competes with production for its own brand terms.
PUBLIC_SITE_NOINDEX="true"
