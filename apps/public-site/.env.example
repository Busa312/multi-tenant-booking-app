API_URL="http://localhost:3001"

# Shared secret checked by POST /api/revalidate — must match apps/api's
# REVALIDATE_SECRET, which apps/api sends after a CMS tenant-colors save.
REVALIDATE_SECRET="change-me-in-production"

# Origin allowed to postMessage draft colors into an embedded preview iframe
# (apps/cms's BrandingSettings page) — must be exact (scheme+host+port, no
# trailing slash). NEXT_PUBLIC_ prefix required so it's readable client-side.
NEXT_PUBLIC_CMS_ORIGIN="http://localhost:5173"

# Error tracking (system_design.md §12a). Leave both empty to disable — and to
# keep the browser SDK (~60 kB) out of every page.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Source-map upload at build time (CI only):
# SENTRY_AUTH_TOKEN="" SENTRY_ORG="" SENTRY_PROJECT=""

# Same value as apps/api's PUBLIC_SITE_API_KEY (named without "PUBLIC" here so
# it isn't mistaken for a browser-exposed NEXT_PUBLIC_ value): vouches for the visitor address this
# server forwards, so the API's rate limits count per visitor (R330).
BOOKING_SITE_API_KEY=""
# R390: "true" on staging only — every page says noindex and no sitemap is
# offered, so test salons stay out of search results. Production leaves it unset.
# Read at build time too (a response header), so redeploy after changing it.
# BLOCK_SEARCH_ENGINES="true"

# R590: the platform's marketing site (R560), credited with a link in every
# booking site's footer — same value as apps/api's MARKETING_URL. Unset, the
# link goes to https://book-it.ge; staging sets its own root domain.
MARKETING_URL="http://localhost:4321"
